                  values="0.6;0.9;0.6"
                  dur="2.2s"
                  repeatCount="indefinite"
                />
              </rect>
            </g>
          </svg>
          
          <AmbientSparkles />
          
          {/* CREATURES & EGGS */}
          <div className="absolute inset-0 z-10">
            {eggs.map((egg, index) => {
              let x = 20 + index * 9;
              let y = 55 + (index % 3) * 9;
              y = Math.max(50, Math.min(72, y));
              x = Math.max(15, Math.min(80, x));
              
              return (
                <motion.div
                  key={egg.id}
                  initial={{ scale: 0, opacity: 0 }}
                  animate={{ scale: 1, opacity: 1, y: [0, -6, 0] }}
                  transition={{
                    scale: { duration: 0.6, ease: 'easeOut' },
                    opacity: { duration: 0.6, ease: 'easeOut' },
                    y: { duration: 2.5 + index * 0.25, repeat: Infinity, ease: 'easeInOut' }
                  }}
                  style={{ left: `${x}%`, top: `${y}%` }}
                  onClick={() => interactWithEgg(egg.id)}
                  className="absolute transform -translate-x-1/2 -translate-y-1/2 cursor-pointer hover:scale-115 transition-transform"
                >
                  <EggSprite egg={egg} size={65} />
                </motion.div>
              );
            })}
            
            {creaturePositions.map(({ creature, position }, index) => (
              <motion.div
                key={creature.id}
                initial={{ scale: 0, opacity: 0 }}
                animate={{
                  scale: 1,
                  opacity: 1,
                  y: [0, -10, 0],
                }}
                transition={{
                  scale: { duration: 0.6, ease: 'easeOut', delay: index * 0.12 },
                  opacity: { duration: 0.6, ease: 'easeOut', delay: index * 0.12 },
                  y: {
                    duration: 3 + index * 0.2,
                    repeat: Infinity,
                    ease: 'easeInOut',
                    delay: index * 0.12
                  },
                }}
                style={{
                  left: `${position.x}%`,
                  top: `${position.y}%`,
                }}
                className="absolute transform -translate-x-1/2 -translate-y-1/2"
              >
                <div className="relative">
                  {/* GROUNDED SHADOW */}
                  <motion.div
                    className="absolute left-1/2 -translate-x-1/2 rounded-full bg-black/22"
                    animate={{
                      scaleX: [1, 1.15, 1],
                      opacity: [0.22, 0.12, 0.22],
                    }}
                    transition={{
                      duration: 3 + index * 0.2,
                      repeat: Infinity,
                      ease: 'easeInOut',
                      delay: index * 0.12,
                    }}
                    style={{
                      bottom: -12,
                      width: 55,
                      height: 12,
                      filter: 'blur(5px)',
                    }}
                  />
                  
                  <CreatureSprite creature={creature} size={75} />
                </div>
              </motion.div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
};
