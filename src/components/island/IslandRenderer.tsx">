interface Position {
  x: number;
  y: number;
}

// TIGHTENED SAFE SPAWN ZONES - grass ONLY
const GRASS_ZONES: { minX: number; maxX: number; minY: number; maxY: number }[] = [
  { minX: 18, maxX: 42, minY: 50, maxY: 68 },
  { minX: 46, maxX: 78, minY: 48, maxY: 62 },
  { minX: 32, maxX: 62, minY: 64, maxY: 72 },
  { minX: 56, maxX: 76, minY: 64, maxY: 72 },
];

const POND_EDGES: { x: number; y: number }[] = [
  { x: 40, y: 58 }, { x: 52, y: 58 }, { x: 42, y: 60 }, { x: 50, y: 60 },
];

const getCreatureZone = (): { minX: number; maxX: number; minY: number; maxY: number } => {
  return GRASS_ZONES[Math.floor(Math.random() * GRASS_ZONES.length)];
};

const getOrganicPosition = (existingPositions: Position[], isNearPond: boolean = false): Position => {
  const MIN_DISTANCE = 13;
  const maxAttempts = 20;
  
  for (let attempt = 0; attempt < maxAttempts; attempt++) {
    let candidate: Position;
    
    if (isNearPond && Math.random() < 0.4) {
      const pondEdge = POND_EDGES[Math.floor(Math.random() * POND_EDGES.length)];
      candidate = {
        x: pondEdge.x + (Math.random() - 0.5) * 8,
        y: pondEdge.y + (Math.random() - 0.5) * 4,
      };
    } else {
      const zone = getCreatureZone();
      candidate = {
        x: zone.minX + Math.random() * (zone.maxX - zone.minX),
        y: zone.minY + Math.random() * (zone.maxY - zone.minY),
      };
    }
    
    // CLAMP TIGHTLY: y between 50-72, x between 15-80
    candidate.y = Math.max(50, Math.min(72, candidate.y));
    candidate.x = Math.max(15, Math.min(80, candidate.x));
    
    const isFarEnough = existingPositions.every(
      existing => Math.sqrt(Math.pow(candidate.x - existing.x, 2) + Math.pow(candidate.y - existing.y, 2)) >= MIN_DISTANCE
    );
    
    if (isFarEnough) return candidate;
  }
  
  const zone = getCreatureZone();
  let y = zone.minY + Math.random() * (zone.maxY - zone.minY);
  y = Math.max(50, Math.min(72, y));
  let x = zone.minX + Math.random() * (zone.maxX - zone.minX);
  x = Math.max(15, Math.min(80, x));
  return { x, y };
};

